{
  "name": "retained-source-history",
  "target": "branch",
  "enforcement": "disabled",
  "bypass_actors": [],
  "conditions": {"ref_name": {
    "include": ["refs/heads/upstream/*", "refs/heads/upstream/**/*"],
    "exclude": []
  }},
  "rules": [{"type": "deletion"}, {"type": "non_fast_forward"}]
}
